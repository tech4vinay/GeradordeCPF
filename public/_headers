# Preview deploys — nunca indexáveis. Os dois nomes de projeto ficam listados de
# propósito: se o projeto do Cloudflare Pages for renomeado para cpfaleatorio, o host
# antigo para de existir e a regra vira inócua; se não for, ela continua valendo.
# Errar para o lado do noindex aqui é barato; indexar um preview não é.
https://cpfaleatorio.pages.dev/*
  X-Robots-Tag: noindex

https://:branch.cpfaleatorio.pages.dev/*
  X-Robots-Tag: noindex

# Fingerprinted Astro assets — cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — cache forever
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Static images — 1 week
/*.svg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.avif
  Cache-Control: public, max-age=604800

# Web manifest — 1 day
/*.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
/*.json
  Cache-Control: public, max-age=86400, must-revalidate

# HTML pages — always revalidate for freshness
#
# Os cabeçalhos de segurança moram aqui porque nenhum deles funciona em <meta>:
# frame-ancestors é ignorado em meta CSP, e X-Frame-Options / HSTS / Referrer-Policy
# só existem como cabeçalho HTTP. O resto da CSP é emitido pelo Astro no <head>.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin

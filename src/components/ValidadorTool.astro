---
import { BTN_GHOST, CARD, HINT, INPUT, LABEL } from '../lib/ui';
---

<section class={CARD} data-validador>
  <div class="p-5 sm:p-6">
    <label class={LABEL} for="v-cpf">CPF para validar</label>
    <input
      class={`${INPUT} font-mono text-base tabular-nums`}
      type="text"
      id="v-cpf"
      name="cpf"
      placeholder="123.456.789-09…"
      inputmode="numeric"
      autocomplete="off"
      spellcheck="false"
      maxlength="18"
    />
    <p class={HINT}>Com ou sem pontuação. A verificação acontece enquanto você digita.</p>

    <!-- Veredicto -->
    <div class="mt-4" data-veredicto role="status" aria-live="polite"></div>
  </div>

  <details class="border-t border-hairline">
    <summary
      class="cursor-pointer list-none px-5 py-3 text-sm font-medium text-ink select-none sm:px-6"
    >
      Validar vários de uma vez <span class="ml-1 text-mute" aria-hidden="true">▾</span>
    </summary>
    <div class="px-5 pb-5 sm:px-6">
      <label class={LABEL} for="v-lote">Um CPF por linha</label>
      <textarea
        id="v-lote"
        rows="6"
        spellcheck="false"
        autocomplete="off"
        placeholder="111.444.777-35&#10;123.456.789-09&#10;…"
        class="w-full rounded-sm border border-hairline bg-elevated p-3 font-mono text-sm tabular-nums text-ink placeholder:text-faint"
      ></textarea>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="button" class={BTN_GHOST} data-acao="validar-lote">Validar lista</button>
        <p class="text-xs text-mute" data-lote-resumo></p>
      </div>
      <div class="mt-4 overflow-x-auto" data-lote-saida></div>
    </div>
  </details>
</section>

<script>
  import { MOTIVOS, formatar, limpar, validar } from '../lib/cpf';

  const raiz = document.querySelector<HTMLElement>('[data-validador]');
  if (raiz) {
    const $cpf = raiz.querySelector<HTMLInputElement>('#v-cpf')!;
    const $veredicto = raiz.querySelector<HTMLElement>('[data-veredicto]')!;
    const $lote = raiz.querySelector<HTMLTextAreaElement>('#v-lote')!;
    const $loteSaida = raiz.querySelector<HTMLElement>('[data-lote-saida]')!;
    const $loteResumo = raiz.querySelector<HTMLElement>('[data-lote-resumo]')!;

    /**
     * A tabela em lote ecoa o que a pessoa colou, inclusive linhas que não são CPF.
     * Sem escapar, `<img onerror=...>` colado ali executaria: escapamos na fronteira.
     */
    const esc = (s: string) =>
      s.replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
      );

    const CHECK = `<svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>`;
    const CROSS = `<svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.3 5.3a1 1 0 0 1 1.4 0L10 8.6l3.3-3.3a1 1 0 1 1 1.4 1.4L11.4 10l3.3 3.3a1 1 0 0 1-1.4 1.4L10 11.4l-3.3 3.3a1 1 0 0 1-1.4-1.4L8.6 10 5.3 6.7a1 1 0 0 1 0-1.4Z" clip-rule="evenodd"/></svg>`;

    function render() {
      const bruto = $cpf.value.trim();
      if (!bruto) {
        $veredicto.innerHTML = '';
        return;
      }

      const r = validar(bruto);

      if (r.valido) {
        $veredicto.innerHTML = `
          <div class="rounded-sm border border-hairline bg-hairline-soft p-4">
            <p class="flex items-center gap-2 text-sm font-medium text-ink">${CHECK} CPF válido</p>
            <p class="mt-2 text-sm text-body">
              <span class="font-mono text-ink">${formatar(limpar(bruto))}</span> passa nos dois dígitos verificadores.
            </p>
            ${
              r.regiao
                ? `<p class="mt-1.5 text-sm text-body">Origem: <strong class="font-medium text-ink">${r.regiao.nome}</strong> (${r.regiao.ufs.join(', ')}): o 9º dígito é <span class="font-mono">${r.regiao.digito}</span>.</p>`
                : ''
            }
          </div>`;
        return;
      }

      // Digitação em andamento: não acusar erro de tamanho antes da hora.
      const incompleto = r.motivo === 'tamanho' && limpar(bruto).length < 11;
      if (incompleto) {
        $veredicto.innerHTML = `<p class="text-sm text-mute">${11 - limpar(bruto).length} dígito(s) faltando…</p>`;
        return;
      }

      $veredicto.innerHTML = `
        <div class="rounded-sm border border-erro/30 bg-erro/5 p-4">
          <p class="flex items-center gap-2 text-sm font-medium text-erro">${CROSS} CPF inválido</p>
          <p class="mt-2 text-sm text-body">${MOTIVOS[r.motivo!]}</p>
          ${
            r.esperado
              ? `<p class="mt-1.5 text-sm text-body">Para esses 9 primeiros dígitos, os verificadores corretos seriam <span class="font-mono text-ink">${r.esperado}</span>.</p>`
              : ''
          }
        </div>`;
    }

    $cpf.addEventListener('input', render);

    raiz.querySelector('[data-acao="validar-lote"]')!.addEventListener('click', () => {
      const linhas = $lote.value
        .split('\n')
        .map((l) => l.trim())
        .filter(Boolean);

      if (!linhas.length) {
        $loteSaida.innerHTML = '';
        $loteResumo.textContent = 'Cole ao menos um CPF.';
        return;
      }

      const resultados = linhas.map((l) => ({ entrada: l, r: validar(l) }));
      const validos = resultados.filter((x) => x.r.valido).length;

      $loteResumo.textContent = `${validos} de ${resultados.length} válidos`;
      $loteSaida.innerHTML = `
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-hairline text-xs text-mute">
              <th scope="col" class="py-2 pr-4 font-medium">CPF</th>
              <th scope="col" class="py-2 pr-4 font-medium">Resultado</th>
              <th scope="col" class="py-2 font-medium">Observação</th>
            </tr>
          </thead>
          <tbody>
            ${resultados
              .map(
                ({ entrada, r }) => `
              <tr class="border-b border-hairline last:border-0">
                <td class="py-2 pr-4 font-mono tabular-nums text-ink">${esc(entrada)}</td>
                <td class="py-2 pr-4 ${r.valido ? 'text-ink' : 'text-erro'}">${r.valido ? 'Válido' : 'Inválido'}</td>
                <td class="py-2 text-body">${r.valido ? (r.regiao?.nome ?? '') : MOTIVOS[r.motivo!]}</td>
              </tr>`,
              )
              .join('')}
          </tbody>
        </table>`;
    });
  }
</script>

---
import { RODAPE, SITE } from '../lib/site';
const ano = new Date().getFullYear();
---

<footer class="mt-24 border-t border-hairline bg-canvas">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        RODAPE.map((grupo) => (
          <div>
            <h2 class="eyebrow mb-4">{grupo.titulo}</h2>
            <ul class="space-y-2.5 text-sm">
              {grupo.links.map((link) => (
                <li>
                  <a href={link.href} class="rounded-sm text-body transition-colors hover:text-ink">
                    {link.rotulo}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-hairline pt-8 text-xs text-mute sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {ano} {SITE.nome} &middot; {SITE.dominio}</p>
      <p class="max-w-xl">
        Os números gerados são fictícios e servem apenas para testar software. Não pertencem a
        ninguém e não consultam nenhuma base da Receita Federal.
      </p>
    </div>
  </div>
</footer>

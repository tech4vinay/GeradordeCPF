---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Faq from '../components/Faq.astro';
import Prose from '../components/Prose.astro';
import { LINGUAGENS, ORG_ID, SITE, SITE_ID, atualizadoEm, faqSchema } from '../lib/site';
import { explicarCalculo, formatar } from '../lib/cpf';
import { CARD, HINT, INPUT, LABEL } from '../lib/ui';

const titulo = 'Dígito verificador do CPF: como calcular e validar (módulo 11)';
const descricao =
  'Calcule o dígito verificador do CPF online e veja a conta do módulo 11 com exemplo resolvido: pesos, soma, resto e os casos especiais que muita gente erra.';

// O exemplo é calculado pela mesma função que a ferramenta usa — a página não tem
// como divergir da implementação.
const EXEMPLO = '11144477735';
const passos = explicarCalculo(EXEMPLO);

// HowTo foi descontinuado pelo Google em setembro de 2023 e depois removido de vez: o
// tipo não rende mais nenhum rich result. TechArticle é o mesmo tipo que /codigo usa e
// carrega autoria e data, que é o que esta página precisa declarar.
const schema = {
  '@type': 'TechArticle',
  '@id': `${SITE.url}/como-validar-cpf#artigo`,
  headline: titulo,
  name: 'Dígito verificador do CPF',
  description: descricao,
  inLanguage: 'pt-BR',
  url: `${SITE.url}/como-validar-cpf`,
  proficiencyLevel: 'Beginner',
  isPartOf: { '@id': SITE_ID },
  publisher: { '@id': ORG_ID },
  author: { '@id': ORG_ID },
  dateModified: atualizadoEm('/como-validar-cpf'),
  about: { '@type': 'Thing', name: 'Cadastro de Pessoas Físicas (CPF)' },
};

// Disjunto das perguntas da home e de /perguntas-frequentes (ver comentário lá).
const FAQ = [
  {
    p: 'Como descobrir os dois últimos dígitos do CPF?',
    r: 'Calculando-os a partir dos nove primeiros. O primeiro verificador vem da soma dos nove dígitos multiplicados por pesos de 10 a 2; o segundo repete a conta com os dez dígitos e pesos de 11 a 2. Em cada uma, divida a soma por 11: resto menor que 2 vira 0, e nos outros casos o dígito é 11 menos o resto. A calculadora no topo desta página faz as duas contas. Isso só funciona quando você já tem os nove primeiros: não há como deduzir o CPF inteiro de outra pessoa, e um resultado correto não prova que o CPF existe.',
    ver: { href: '/validador-de-cpf', rotulo: 'Validar um CPF completo.' },
  },
  {
    p: 'O que significa "dígito verificador 04" no comprovante do CPF?',
    r: 'No comprovante de situação cadastral da Receita Federal, o campo "Dígito Verificador" não é o do módulo 11 explicado nesta página: é um código de dois dígitos que acompanha a situação cadastral. O 04, por exemplo, aparece junto de "Pendente de regularização". O que vale é a situação escrita por extenso no comprovante.',
    ver: { href: '/cpf-invalido', rotulo: 'Entenda as situações do CPF.' },
  },
  {
    p: 'O dígito verificador do CPF muda de acordo com o estado?',
    r: 'Não. Os dois verificadores dependem apenas dos nove dígitos que vêm antes, pela conta do módulo 11. O estado entra só pelo nono dígito, que indica a região fiscal e participa da conta como qualquer outro. Por isso CPFs de estados diferentes seguem exatamente a mesma regra de cálculo.',
    ver: { href: '/o-que-e-cpf#regiao', rotulo: 'Veja a tabela de regiões fiscais.' },
  },
];
---

<Base
  titulo={titulo}
  descricao={descricao}
  schema={[schema, faqSchema('/como-validar-cpf', FAQ)]}
  migalha="Dígito verificador do CPF"
>
  <Cabecalho
    eyebrow="Algoritmo"
    titulo="Dígito verificador do CPF: como calcular e validar"
    lead="Os dois últimos dígitos do CPF são calculados a partir dos nove primeiros pelo módulo 11. É isso que permite detectar um dígito trocado sem consultar base nenhuma."
  />

  <!-- Calculadora: o exemplo da página já vem preenchido, então o HTML tem resultado real -->
  <div class="mx-auto max-w-2xl px-4 pt-10 sm:px-6">
    <section class={`${CARD} p-5 sm:p-6`} data-calc-dv>
      <label class={LABEL} for="dv-base">Calcular dígito verificador</label>
      <input
        class={`${INPUT} font-mono text-base tabular-nums`}
        type="text"
        id="dv-base"
        value={formatar(EXEMPLO).slice(0, 11)}
        inputmode="numeric"
        autocomplete="off"
        spellcheck="false"
        maxlength="11"
      />
      <p class={HINT}>Digite os 9 primeiros dígitos do CPF, com ou sem pontos.</p>
      <p class="mt-4 text-sm text-body" role="status" aria-live="polite" data-calc-saida>
        Dígitos verificadores: <strong class="font-mono text-ink">{EXEMPLO.slice(9)}</strong> · CPF
        completo: <span class="font-mono text-ink select-all">{formatar(EXEMPLO)}</span>
      </p>
    </section>
  </div>

  <Prose>
    <h2>A estrutura do número</h2>
    <p>
      Os 11 dígitos se dividem em três partes. Tomando <code>{formatar(EXEMPLO)}</code> como
      exemplo:
    </p>
    <ul>
      <li>
        <strong>Dígitos 1 a 8</strong>: o número de série dentro da região.
      </li>
      <li>
        <strong>Dígito 9</strong>: a <a href="/o-que-e-cpf#regiao">região fiscal</a> onde o CPF
        foi emitido.
      </li>
      <li>
        <strong>Dígitos 10 e 11</strong>: os verificadores, calculados abaixo.
      </li>
    </ul>

    <h2>Como calcular o dígito verificador</h2>
    <p>
      Os dois dígitos usam a mesma receita, chamada <strong>módulo 11</strong>. Muda apenas
      quantos dígitos entram na conta e, por consequência, os pesos:
    </p>
    <ol>
      <li>Multiplique cada dígito por um peso, que começa alto e decresce até 2.</li>
      <li>Some todos os produtos.</li>
      <li>Divida a soma por 11 e guarde o <strong>resto</strong>.</li>
      <li>
        Se o resto for <strong>menor que 2</strong>, o dígito verificador é <strong>0</strong>.
        Caso contrário, é <strong>11 menos o resto</strong>.
      </li>
    </ol>
    <p>
      O passo 4 é onde a maioria das implementações caseiras erra: esquecer o caso do resto 0 ou 1
      produz um validador que rejeita CPFs legítimos terminados em 0.
    </p>

    <h2>Exemplo resolvido: {formatar(EXEMPLO)}</h2>

    {
      passos.map((p) => (
        <>
          <h3>{p.rotulo} dígito verificador</h3>
          <p>
            Entram {p.digitos.length} dígitos, com pesos de {p.pesos[0]} a 2:
          </p>
          <div class="my-4 overflow-x-auto rounded-md border border-hairline bg-elevated p-4">
            <table class="w-full text-center font-mono text-sm tabular-nums">
              <tbody>
                <tr>
                  <th scope="row" class="pr-3 text-left text-xs font-medium text-mute">Dígito</th>
                  {p.digitos.map((d) => (
                    <td class="px-1.5 text-ink">{d}</td>
                  ))}
                </tr>
                <tr>
                  <th scope="row" class="pr-3 text-left text-xs font-medium text-mute">Peso</th>
                  {p.pesos.map((w) => (
                    <td class="px-1.5 text-body">{w}</td>
                  ))}
                </tr>
                <tr>
                  <th scope="row" class="pr-3 text-left text-xs font-medium text-mute">Produto</th>
                  {p.produtos.map((v) => (
                    <td class="px-1.5 text-ink">{v}</td>
                  ))}
                </tr>
              </tbody>
            </table>
          </div>
          <p>
            Soma = <strong>{p.soma}</strong>. Dividindo por 11, o resto é{' '}
            <strong>{p.resto}</strong>.{' '}
            {p.resto < 2
              ? 'Como o resto é menor que 2, o dígito é 0.'
              : `Como o resto é 2 ou mais, o dígito é 11 − ${p.resto} = ${p.resultado}.`}{' '}
            O {p.rotulo.toLowerCase()} dígito verificador é <strong>{p.resultado}</strong>.
          </p>
        </>
      ))
    }

    <p>
      Os dois dígitos calculados são <strong>{passos.map((p) => p.resultado).join('')}</strong>, que
      é exatamente como <code>{formatar(EXEMPLO)}</code> termina. O CPF é válido.
    </p>

    <h2>Como validar um CPF</h2>
    <p>
      Validar é a mesma conta: calcule os dois dígitos verificadores a partir dos nove primeiros e
      compare com os dois últimos informados. Se algum for diferente, ou se os 11 dígitos forem
      iguais, o CPF é inválido. Para conferir um número pronto, o
      <a href="/validador-de-cpf">validador de CPF</a> faz isso e aponta qual dígito falhou. Se o
      número foi reprovado, <a href="/cpf-invalido">CPF inválido: o que significa e o que fazer</a>
      explica as causas e a diferença para um CPF irregular na Receita.
    </p>

    <h2>Os dois casos especiais</h2>
    <h3>Resto 0 ou 1</h3>
    <p>
      Quando a soma é divisível por 11, ou deixa resto 1, o dígito verificador é <strong>0</strong>.
      Aplicar 11 menos o resto nesses casos daria 11 ou 10, números de dois dígitos, que não cabem
      numa posição. Cada dígito verificador cai nessa situação em 2 dos 11 restos possíveis, ou seja
      18,2% das vezes; como basta um dos dois para quebrar a conta, um validador que pula essa regra
      rejeita <strong>cerca de um terço</strong> dos CPFs válidos (40/121, ou 33,1%).
    </p>

    <h3>Todos os dígitos iguais</h3>
    <p>
      <code>111.111.111-11</code>, <code>000.000.000-00</code> e as outras oito sequências desse
      tipo <strong>passam</strong> no cálculo do módulo 11. Ainda assim não são CPFs válidos, e
      precisam ser rejeitadas por uma regra à parte. Como são exatamente o que alguém digita para
      testar um formulário, esquecer esse caso costuma custar caro.
    </p>

    <h2>Implementações prontas</h2>
    <p>
      A função de validação escrita e comentada em
      {
        LINGUAGENS.map((l, i) => (
          <>
            {i > 0 && (i === LINGUAGENS.length - 1 ? ' e ' : ', ')}
            <a href={`/codigo#${l.slug}`}>{l.nome}</a>
          </>
        ))
      }.
    </p>
    <p>
      Para ver a conta acontecendo com números novos, use a ferramenta para
      <a href="/">gerar CPF aleatório</a>: ela mostra a memória de cálculo de cada CPF que produz.
    </p>
  </Prose>

  <Faq titulo="Perguntas frequentes sobre o dígito verificador" itens={FAQ} />
</Base>

<script>
  import { explicarCalculo, formatar, limpar } from '../lib/cpf';

  const raiz = document.querySelector<HTMLElement>('[data-calc-dv]');
  if (raiz) {
    const $base = raiz.querySelector<HTMLInputElement>('#dv-base')!;
    const $saida = raiz.querySelector<HTMLElement>('[data-calc-saida]')!;

    $base.addEventListener('input', () => {
      const base = limpar($base.value);
      if (base.length !== 9) {
        $saida.textContent =
          base.length < 9 ? `Faltam ${9 - base.length} dígito(s).` : 'Use só os 9 primeiros dígitos.';
        return;
      }
      const dvs = explicarCalculo(base).map((p) => p.resultado).join('');
      const cpf = formatar(base + dvs);
      // 111.111.111-11 e afins fecham a conta, mas são rejeitados por regra à parte.
      const aviso = /^(\d)\1{8}$/.test(base) ? ' (sequência repetida: inválido mesmo assim)' : '';
      $saida.innerHTML = `Dígitos verificadores: <strong class="font-mono text-ink">${dvs}</strong> · CPF completo: <span class="font-mono text-ink select-all">${cpf}</span>${aviso}`;
    });
  }
</script>
